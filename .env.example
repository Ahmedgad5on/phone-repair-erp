# NEVER commit the real .env file (git-ignored).
# ENV VARS = operational configuration only (ports, paths, secrets, log level).
# BUSINESS THRESHOLDS ARE NOT ENV VARS — they live in the settings table,
#   runtime-configurable by MANAGER/ADMIN:
#   - Payment approval ceiling 5,000 EGP (DEC-028)
#   - PO approval ceiling 10,000 EGP (DEC-034)
#   - Warranty durations 90/60/30 + 3-day grace (DEC-041)
# Changing these requires governance review, not a deploy.

# ─── OPERATIONAL NETWORKING & HOST CONFIGURATION ───

# Purpose: Express API server listen port (server/src/index.ts#L77)
# Status: Required
# Example: 5000
PORT=5000

# Purpose: Application runtime mode governing subnet guards and error details (server/src/index.ts#L94, server/src/middleware/subnet-guard.ts#L10)
# Status: Required (enum: development | production)
# Note: Subnet guard currently uses fallback-ALLOW in development mode per RISK-011
NODE_ENV=development

# Purpose: Allowed browser client origins for CORS validation (server/src/index.ts#L91)
# Status: Optional (defaults to http://localhost:3000,http://localhost:5173)
# Example: http://localhost:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ─── STORAGE & DURABILITY PATHS ───

# Purpose: Relative or absolute path to SQLite database file (server/src/db/database.ts#L5, server/src/services/backup.service.ts#L66)
# Status: Required (verified real path matching README architecture blueprint)
# Example: server/data/erp.db
DB_PATH=server/data/erp.db

# Purpose: Local directory for hot online SQLite backup snapshots (server/src/index.ts#L283)
# Status: Required
# Example: server/backups
BACKUP_DIR=server/backups

# Purpose: External removable mirror target for physical disaster recovery (Constitution §1 Principle III.4, DEC-003)
# Status: Optional (Absence triggers red dashboard warning banner per DEC-015; never a silent skip)
# Example: E:\ERP_Backups
USB_BACKUP_PATH=E:\ERP_Backups

# ─── SECURITY & AUTHENTICATION SECRETS ───

# Purpose: Universal auth token signing secret (server/src/middleware/auth.ts#L12)
# Status: Required
# Example: Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=<GENERATE: see command below>

# Purpose: Production JWT token signing key alias (server/src/middleware/auth.ts#L8-L12)
# Status: Required in production (enforced without fallback by auth guard)
# Example: Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<GENERATE: see command below>

# Purpose: Device registration & workstation fingerprint hashing salt (server/src/services/crypto.service.ts#L5)
# Status: Required
# Example: Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DEVICE_TOKEN_SALT=<GENERATE: see command below>

# ─── LOGGING & OBSERVABILITY ───

# Purpose: Structured log verbosity level (server/src/services/logger.ts)
# Status: Optional (enum: debug | info | warn | error; default: info)
# Example: info
LOG_LEVEL=info

# ─── WHATSAPP (FUTURE — DEC-019: Meta Cloud API target) ───
# WHATSAPP_PHONE_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
