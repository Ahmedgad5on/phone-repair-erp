/*
 * ProLab Mobile Phone Trading ERP — Obsidian Black & Metallic Gold Studio Theme
 * Theme Palette:
 *   Obsidian Black:        #0D0D11 (Deep background)
 *   Elevated Charcoal:     #16161D (Card containers & panels)
 *   Elevated Charcoal Alt: #1F1F28 (Inputs, table alternates)
 *   Glass Borders:         #282834 (Subtle borders)
 *   Metallic Gold Accent:  #D4AF37 (Buttons, active states, highlights)
 *   Metallic Gold Hover:   #E5C158 (Hover effects)
 *   Metallic Gold Pressed: #B89628 (Active clicks)
 *   Crisp White Text:      #F4F4F6 (Headings, primary text)
 *   Muted Silver Text:     #9CA3AF (Labels, secondary text)
 *   Emerald Positive:      #10B981 (Success, in-stock, positive balance)
 *   Amber Warning:         #F59E0B (Warnings, aging 15d, pending approvals)
 *   Crimson Alert:         #EF4444 (Errors, aging 30d, debt, voids)
 */

/* =========================================================================
   Executive Navigation Sidebar
   ========================================================================= */

QFrame#SidebarFrame {
    background-color: #121217;
    border-right: 2px solid #282834;
}

QPushButton.nav-btn {
    text-align: right;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #9CA3AF;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    margin: 2px 6px;
}

QPushButton.nav-btn:hover {
    background-color: #1A1A24;
    color: #F4F4F6;
}

QPushButton.nav-btn:checked, QPushButton.nav-btn.active {
    background-color: #1F1F2C;
    color: #D4AF37;
    border-right: 3px solid #D4AF37;
    font-weight: 700;
}

/* =========================================================================
   Base Window & Containers
   ========================================================================= */

QMainWindow, QDialog, QWidget {
    background-color: #0D0D11;
    color: #F4F4F6;
    font-family: 'Segoe UI', 'Cairo', -apple-system, sans-serif;
    font-size: 13px;
    selection-background-color: #D4AF37;
    selection-color: #0D0D11;
}

QFrame.card, QWidget.card, QFrame#card {
    background-color: #16161D;
    border: 1px solid #282834;
    border-radius: 8px;
    padding: 10px;
}

QFrame.card-highlight {
    background-color: #1A1A24;
    border: 1px solid #D4AF37;
    border-radius: 8px;
    padding: 12px;
}

/* =========================================================================
   Labels & Typography
   ========================================================================= */

QLabel {
    color: #F4F4F6;
    background: transparent;
}

QLabel.title, QLabel#title {
    color: #D4AF37;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QLabel.subtitle {
    color: #9CA3AF;
    font-size: 12px;
}

QLabel.muted {
    color: #9CA3AF;
}

QLabel.emerald {
    color: #10B981;
    font-weight: 600;
}

QLabel.amber {
    color: #F59E0B;
    font-weight: 600;
}

QLabel.crimson {
    color: #EF4444;
    font-weight: 600;
}

QLabel.gold {
    color: #D4AF37;
    font-weight: 600;
}

/* =========================================================================
   Buttons
   ========================================================================= */

QPushButton {
    background-color: #1F1F28;
    color: #F4F4F6;
    border: 1px solid #282834;
    border-radius: 6px;
    padding: 7px 15px;
    font-weight: 600;
    font-size: 13px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #282836;
    border-color: #D4AF37;
    color: #E5C158;
}

QPushButton:pressed {
    background-color: #16161D;
    border-color: #B89628;
    color: #D4AF37;
}

QPushButton:disabled {
    background-color: #121217;
    color: #555566;
    border-color: #1F1F28;
}

/* Primary Gold Button */
QPushButton.primary, QPushButton#btnPrimary {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #D4AF37, stop:1 #E5C158);
    color: #0D0D11;
    border: 1px solid #D4AF37;
    border-radius: 6px;
    font-weight: 700;
    font-size: 13px;
    padding: 8px 18px;
}

QPushButton.primary:hover, QPushButton#btnPrimary:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #E5C158, stop:1 #F3D978);
    border-color: #F3D978;
}

QPushButton.primary:pressed, QPushButton#btnPrimary:pressed {
    background-color: #B89628;
    border-color: #B89628;
    color: #000000;
}

/* Success Emerald Button */
QPushButton.success {
    background-color: #10B981;
    color: #FFFFFF;
    border: 1px solid #059669;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton.success:hover {
    background-color: #34D399;
}

/* Danger Crimson Button */
QPushButton.danger {
    background-color: #EF4444;
    color: #FFFFFF;
    border: 1px solid #DC2626;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton.danger:hover {
    background-color: #F87171;
}

/* Warning Amber Button */
QPushButton.warning {
    background-color: #F59E0B;
    color: #0D0D11;
    border: 1px solid #D97706;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton.warning:hover {
    background-color: #FBBF24;
}

/* =========================================================================
   Input Fields, SpinBoxes, ComboBoxes
   ========================================================================= */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1F1F28;
    color: #F4F4F6;
    border: 1px solid #282834;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #D4AF37;
    selection-color: #0D0D11;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #D4AF37;
    background-color: #242430;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #121217;
    color: #555566;
    border-color: #1A1A22;
}

QComboBox {
    background-color: #1F1F28;
    color: #F4F4F6;
    border: 1px solid #282834;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 20px;
}

QComboBox:focus, QComboBox:hover {
    border: 1px solid #D4AF37;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #282834;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #D4AF37;
    margin: 4px;
}

QComboBox QAbstractItemView {
    background-color: #16161D;
    color: #F4F4F6;
    border: 1px solid #D4AF37;
    selection-background-color: #D4AF37;
    selection-color: #0D0D11;
    padding: 4px;
}

QSpinBox, QDoubleSpinBox {
    background-color: #1F1F28;
    color: #F4F4F6;
    border: 1px solid #282834;
    border-radius: 6px;
    padding: 5px 8px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #D4AF37;
}

/* =========================================================================
   Tabs & Navigation
   ========================================================================= */

QTabWidget::pane {
    background-color: #16161D;
    border: 1px solid #282834;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #0D0D11;
    color: #9CA3AF;
    border: 1px solid #282834;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 16px;
    margin-right: 3px;
    font-weight: 600;
}

QTabBar::tab:hover {
    background-color: #16161D;
    color: #E5C158;
}

QTabBar::tab:selected {
    background-color: #16161D;
    color: #D4AF37;
    border-top: 2px solid #D4AF37;
    border-bottom: 1px solid #16161D;
}

/* =========================================================================
   Tables & Lists
   ========================================================================= */

QTableWidget, QTableView {
    background-color: #16161D;
    color: #F4F4F6;
    border: 1px solid #282834;
    border-radius: 6px;
    gridline-color: #232330;
    selection-background-color: #282838;
    selection-color: #D4AF37;
    alternate-background-color: #1A1A22;
}

QHeaderView::section {
    background-color: #121217;
    color: #D4AF37;
    font-weight: 700;
    padding: 7px;
    border: none;
    border-bottom: 2px solid #282834;
    border-right: 1px solid #1F1F28;
}

QTableWidget::item {
    padding: 5px 8px;
    border-bottom: 1px solid #1F1F28;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #222230;
    color: #F4F4F6;
    border-left: 2px solid #D4AF37;
}

/* =========================================================================
   Checkboxes & Radio Buttons
   ========================================================================= */

QCheckBox, QRadioButton {
    color: #F4F4F6;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 17px;
    height: 17px;
    background-color: #1F1F28;
    border: 1px solid #282834;
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #D4AF37;
}

QCheckBox::indicator:checked {
    background-color: #D4AF37;
    border-color: #E5C158;
}

QRadioButton::indicator:checked {
    background-color: #D4AF37;
    border-color: #E5C158;
}

/* =========================================================================
   ScrollBars
   ========================================================================= */

QScrollBar:vertical {
    background: #0D0D11;
    width: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #282834;
    min-height: 25px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #D4AF37;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #0D0D11;
    height: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #282834;
    min-width: 25px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #D4AF37;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* =========================================================================
   Group Boxes & Splitters
   ========================================================================= */

QGroupBox {
    background-color: #16161D;
    border: 1px solid #282834;
    border-radius: 8px;
    margin-top: 15px;
    padding-top: 15px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #D4AF37;
    font-size: 13px;
}

QSplitter::handle {
    background-color: #282834;
}

QSplitter::handle:hover {
    background-color: #D4AF37;
}

/* =========================================================================
   Menu & Context Menus
   ========================================================================= */

QMenuBar {
    background-color: #0D0D11;
    color: #F4F4F6;
    border-bottom: 1px solid #282834;
}

QMenuBar::item:selected {
    background-color: #16161D;
    color: #D4AF37;
}

QMenu {
    background-color: #16161D;
    color: #F4F4F6;
    border: 1px solid #282834;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #D4AF37;
    color: #0D0D11;
}

/* =========================================================================
   ToolTips & Badges
   ========================================================================= */

QToolTip {
    background-color: #1F1F28;
    color: #F4F4F6;
    border: 1px solid #D4AF37;
    border-radius: 4px;
    padding: 5px 8px;
}

/* Role Badges */
QLabel.role-owner {
    background-color: #3B2A08;
    color: #D4AF37;
    border: 1px solid #D4AF37;
    border-radius: 4px;
    padding: 3px 8px;
    font-weight: 700;
}

QLabel.role-sales {
    background-color: #0E2938;
    color: #38BDF8;
    border: 1px solid #0284C7;
    border-radius: 4px;
    padding: 3px 8px;
    font-weight: 700;
}
