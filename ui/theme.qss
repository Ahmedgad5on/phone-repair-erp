/*
 * ==============================================================================
 * ThermalLabPro Commercial ERP Studio — Obsidian Titanium & Cyber-Gold Design System
 * Inspired by Modern Executive Software (Linear, Raycast, Figma Studio)
 * Base: #121212, Surface: #1E1E1E, Accent: #D4AF37
 *
 * Studio Palette Tokens:
 *   Obsidian Void Canvas:  #08090E (Infinite space, dark workspace canvas)
 *   Obsidian Console:      #0B0D14 (Sidebar dock, header panels, navigation)
 *   Glass Surface (Base):  #11141F (Cards, tab panes, grid containers)
 *   Elevated Charcoal:     #151924 (Interactive inputs, modals, elevated cards)
 *   Hover State Surface:   #1B2030 (Hovered controls, table alternate rows)
 *   Hairline Glass Border: #1D2333 (Subtle glass separators, container outlines)
 *   Elevated Card Border:  #252D42 (Card borders and active boundaries)
 *   Cyber-Gold Accent:     #F59E0B (Vibrant amber-gold, CTA, active indicator)
 *   Cyber-Gold Bright:     #FBBF24 (Hover highlights, glowing states)
 *   Cyber-Gold Deep:       #D97706 (Pressed buttons, active borders)
 *   Electric Cyan:         #06B6D4 (USB diagnostics, ADB telemetry, fast reload)
 *   Cyber Emerald:         #10B981 (Positive balance, in-stock, online)
 *   Neon Rose / Alert:     #F43F5E (Debt, aging stock, voids, warnings)
 *   Pure White Text:       #FFFFFF (Headings, primary values, active tab)
 *   Crisp Body Text:       #F1F5F9 (Primary form text, table cells)
 *   Muted Silver Text:     #94A3B8 (Labels, secondary descriptions)
 *   Dimmed Caption:        #64748B (Hints, hotkeys, metadata)
 * ==============================================================================
 */

/* =============================================================================
   1. Base Window & Root Containers
   ============================================================================= */

QMainWindow, QDialog {
    background-color: #08090E;
    color: #F1F5F9;
    font-family: 'Segoe UI', 'Cairo', -apple-system, BlinkMacSystemFont, Arial, sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: transparent;
    color: #F1F5F9;
    font-family: 'Segoe UI', 'Cairo', -apple-system, BlinkMacSystemFont, Arial, sans-serif;
    font-size: 13px;
    selection-background-color: #F59E0B;
    selection-color: #08090E;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

/* Glass Card Surfaces */
QFrame.card, QWidget.card, QFrame#card, QFrame[class="card"], QFrame[class~="card"] {
    background-color: #11141F;
    border: 1px solid #1D2333;
    border-radius: 8px;
    padding: 12px;
}

QFrame.card-elevated, QFrame#card-elevated, QFrame[class="card-elevated"], QFrame[class~="card-elevated"] {
    background-color: #151924;
    border: 1px solid #252D42;
    border-radius: 8px;
    padding: 12px;
}

QFrame.card-highlight, QFrame#card-highlight, QFrame[class="card-highlight"], QFrame[class~="card-highlight"] {
    background-color: #151924;
    border: 1px solid #F59E0B;
    border-radius: 8px;
    padding: 12px;
}

/* =============================================================================
   2. Executive Navigation Sidebar
   ============================================================================= */

QFrame#SidebarFrame {
    background-color: #0B0D14;
    border-left: 1px solid #1D2333;
    border-right: 1px solid #1D2333;
}

QPushButton.nav-btn, QPushButton[class="nav-btn"], QPushButton[class~="nav-btn"] {
    text-align: right;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #94A3B8;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    margin: 2px 4px;
}

QPushButton.nav-btn:hover, QPushButton[class="nav-btn"]:hover, QPushButton[class~="nav-btn"]:hover {
    background-color: #151924;
    color: #FFFFFF;
}

QPushButton.nav-btn:checked, QPushButton.nav-btn.active, QPushButton[class="nav-btn"]:checked, QPushButton[class~="nav-btn"]:checked {
    background: qlineargradient(x1:1, y1:0, x2:0, y2:0, stop:0 rgba(245, 158, 11, 0.18), stop:1 rgba(245, 158, 11, 0.02));
    color: #F59E0B;
    border-right: 3px solid #F59E0B;
    font-weight: 700;
}

/* =============================================================================
   3. Typography & Hierarchy
   ============================================================================= */

QLabel {
    color: #F1F5F9;
    background: transparent;
}

QLabel.title, QLabel#title {
    color: #F59E0B;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QLabel.subtitle {
    color: #94A3B8;
    font-size: 12px;
    font-weight: 500;
}

QLabel.muted {
    color: #64748B;
    font-size: 11px;
}

QLabel.gold {
    color: #F59E0B;
    font-weight: 700;
}

QLabel.emerald {
    color: #10B981;
    font-weight: 700;
}

QLabel.amber {
    color: #F59E0B;
    font-weight: 700;
}

QLabel.crimson {
    color: #F43F5E;
    font-weight: 700;
}

QLabel.cyan {
    color: #06B6D4;
    font-weight: 700;
}

/* =============================================================================
   4. Buttons (Modern Pill & Rounded-Rect Architecture)
   ============================================================================= */

QPushButton {
    background-color: #151924;
    color: #F1F5F9;
    border: 1px solid #252D42;
    border-radius: 6px;
    padding: 7px 16px;
    font-weight: 600;
    font-size: 13px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #1B2030;
    border-color: #F59E0B;
    color: #FBBF24;
}

QPushButton:pressed {
    background-color: #10131E;
    border-color: #D97706;
    color: #F59E0B;
}

QPushButton:disabled {
    background-color: #0E1018;
    color: #475569;
    border-color: #1A1F2C;
}

/* Primary Brushed Cyber-Gold Button */
QPushButton.primary, QPushButton#btnPrimary, QPushButton[class="primary"], QPushButton[class~="primary"], QPushButton[primary="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #F59E0B, stop:1 #D97706);
    color: #08090E;
    border: 1px solid #F59E0B;
    border-radius: 6px;
    font-weight: 800;
    font-size: 13px;
    padding: 8px 20px;
}

QPushButton.primary:hover, QPushButton#btnPrimary:hover, QPushButton[class="primary"]:hover, QPushButton[primary="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FBBF24, stop:1 #F59E0B);
    border-color: #FDE68A;
    color: #000000;
}

QPushButton.primary:pressed, QPushButton#btnPrimary:pressed, QPushButton[class="primary"]:pressed, QPushButton[primary="true"]:pressed {
    background-color: #B45309;
    border-color: #B45309;
    color: #000000;
}

/* Secondary Button */
QPushButton.secondary, QPushButton[class="secondary"], QPushButton[class~="secondary"] {
    background-color: #181D2A;
    color: #E2E8F0;
    border: 1px solid #2A3347;
    border-radius: 6px;
    padding: 7px 16px;
    font-weight: 600;
}

QPushButton.secondary:hover, QPushButton[class="secondary"]:hover {
    background-color: #202738;
    border-color: #F59E0B;
    color: #FFFFFF;
}

/* Success Emerald Button */
QPushButton.success, QPushButton[class="success"], QPushButton[class~="success"], QPushButton[success="true"] {
    background-color: #064E3B;
    color: #6EE7B7;
    border: 1px solid #059669;
    border-radius: 6px;
    font-weight: 700;
}

QPushButton.success:hover, QPushButton[class="success"]:hover, QPushButton[success="true"]:hover {
    background-color: #047857;
    border-color: #10B981;
    color: #A7F3D0;
}

QPushButton.success:pressed, QPushButton[class="success"]:pressed, QPushButton[success="true"]:pressed {
    background-color: #022C22;
    border-color: #065F46;
}

/* Danger Crimson / Rose Button */
QPushButton.danger, QPushButton[class="danger"], QPushButton[class~="danger"], QPushButton[danger="true"] {
    background-color: #4C0519;
    color: #FDA4AF;
    border: 1px solid #E11D48;
    border-radius: 6px;
    font-weight: 700;
}

QPushButton.danger:hover, QPushButton[class="danger"]:hover, QPushButton[danger="true"]:hover {
    background-color: #881337;
    border-color: #F43F5E;
    color: #FECDD3;
}

QPushButton.danger:pressed, QPushButton[class="danger"]:pressed, QPushButton[danger="true"]:pressed {
    background-color: #380310;
    border-color: #9F1239;
}

/* Warning Amber Button */
QPushButton.warning, QPushButton[class="warning"], QPushButton[class~="warning"], QPushButton[warning="true"] {
    background-color: #451A03;
    color: #FDE68A;
    border: 1px solid #D97706;
    border-radius: 6px;
    font-weight: 700;
}

QPushButton.warning:hover, QPushButton[class="warning"]:hover, QPushButton[warning="true"]:hover {
    background-color: #78350F;
    border-color: #F59E0B;
    color: #FEF3C7;
}

/* Ghost / Flat Button */
QPushButton.ghost, QPushButton[class="ghost"], QPushButton[class~="ghost"] {
    background-color: transparent;
    color: #94A3B8;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton.ghost:hover, QPushButton[class="ghost"]:hover {
    background-color: #151924;
    color: #F59E0B;
}

/* =============================================================================
   5. Form Inputs, ComboBoxes & SpinBoxes
   ============================================================================= */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #151924;
    color: #F1F5F9;
    border: 1px solid #252D42;
    border-radius: 6px;
    padding: 7px 12px;
    selection-background-color: #F59E0B;
    selection-color: #08090E;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #F59E0B;
    background-color: #1B2030;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #0E1018;
    color: #475569;
    border-color: #1A1F2C;
}

QComboBox {
    background-color: #151924;
    color: #F1F5F9;
    border: 1px solid #252D42;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 24px;
}

QComboBox:hover, QComboBox:focus {
    border: 1px solid #F59E0B;
    background-color: #1B2030;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #252D42;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #F59E0B;
    margin: 4px;
}

QComboBox QAbstractItemView {
    background-color: #11141F;
    color: #F1F5F9;
    border: 1px solid #F59E0B;
    border-radius: 6px;
    selection-background-color: #F59E0B;
    selection-color: #08090E;
    padding: 4px;
}

QSpinBox, QDoubleSpinBox {
    background-color: #151924;
    color: #F1F5F9;
    border: 1px solid #252D42;
    border-radius: 6px;
    padding: 6px 10px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #F59E0B;
    background-color: #1B2030;
}

/* =============================================================================
   6. Tabs & Segmented Navigation
   ============================================================================= */

QTabWidget::pane {
    background-color: #11141F;
    border: 1px solid #1D2333;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #0B0D14;
    color: #94A3B8;
    border: 1px solid #1D2333;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 18px;
    margin-right: 2px;
    font-weight: 600;
}

QTabBar::tab:hover {
    background-color: #151924;
    color: #FBBF24;
}

QTabBar::tab:selected {
    background-color: #11141F;
    color: #F59E0B;
    border-top: 2px solid #F59E0B;
    border-bottom: 1px solid #11141F;
    font-weight: 700;
}

/* =============================================================================
   7. Tables & Data Grids (shadcn DataTable Style)
   ============================================================================= */

QTableWidget, QTableView {
    background-color: #0E1018;
    color: #F1F5F9;
    border: 1px solid #1D2333;
    border-radius: 6px;
    gridline-color: #191E2C;
    selection-background-color: #1B2132;
    selection-color: #FFFFFF;
    alternate-background-color: #121520;
}

QHeaderView::section {
    background-color: #090B12;
    color: #F59E0B;
    font-weight: 700;
    font-size: 12px;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #1D2333;
    border-right: 1px solid #161A26;
}

QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #161A26;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #1E2538;
    color: #FFFFFF;
    border-right: 3px solid #F59E0B;
}

/* =============================================================================
   8. Checkboxes, Radio Buttons & Sliders
   ============================================================================= */

QCheckBox, QRadioButton {
    color: #F1F5F9;
    spacing: 8px;
    font-weight: 500;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    background-color: #151924;
    border: 1px solid #252D42;
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #F59E0B;
}

QCheckBox::indicator:checked {
    background-color: #F59E0B;
    border-color: #FBBF24;
}

QRadioButton::indicator:checked {
    background-color: #F59E0B;
    border-color: #FBBF24;
}

/* =============================================================================
   9. Ultra-Smooth Slim Scrollbars
   ============================================================================= */

QScrollBar:vertical {
    background: #08090E;
    width: 7px;
    margin: 0;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #1D2333;
    min-height: 28px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #F59E0B;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #08090E;
    height: 7px;
    margin: 0;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: #1D2333;
    min-width: 28px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #F59E0B;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* =============================================================================
   10. GroupBoxes & Splitters
   ============================================================================= */

QGroupBox {
    background-color: #11141F;
    border: 1px solid #1D2333;
    border-radius: 8px;
    margin-top: 16px;
    padding-top: 16px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 0 10px;
    color: #F59E0B;
    font-size: 13px;
    font-weight: 800;
}

QSplitter::handle {
    background-color: #1D2333;
}

QSplitter::handle:hover {
    background-color: #F59E0B;
}

/* =============================================================================
   11. Menus, Status Bar & Tooltips
   ============================================================================= */

QMenuBar {
    background-color: #08090E;
    color: #F1F5F9;
    border-bottom: 1px solid #1D2333;
}

QMenuBar::item:selected {
    background-color: #151924;
    color: #F59E0B;
}

QMenu {
    background-color: #11141F;
    color: #F1F5F9;
    border: 1px solid #252D42;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item {
    padding: 7px 22px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #F59E0B;
    color: #08090E;
    font-weight: 600;
}

QStatusBar {
    background-color: #0B0D14;
    color: #94A3B8;
    border-top: 1px solid #1D2333;
}

QToolTip {
    background-color: #151924;
    color: #F1F5F9;
    border: 1px solid #F59E0B;
    border-radius: 5px;
    padding: 6px 10px;
    font-size: 11px;
}

/* =============================================================================
   12. Status Chips & Badges
   ============================================================================= */

QLabel.badge-gold, QLabel.BadgeGold, QLabel[class="badge-gold"], QLabel[class~="badge-gold"] {
    background-color: rgba(245, 158, 11, 0.14);
    color: #F59E0B;
    border: 1px solid #F59E0B;
    border-radius: 4px;
    padding: 3px 8px;
    font-weight: 700;
    font-size: 11px;
}

QLabel.badge-emerald, QLabel.BadgeEmerald, QLabel[class="badge-emerald"], QLabel[class~="badge-emerald"] {
    background-color: rgba(16, 185, 129, 0.14);
    color: #10B981;
    border: 1px solid #10B981;
    border-radius: 4px;
    padding: 3px 8px;
    font-weight: 700;
    font-size: 11px;
}

QLabel.badge-crimson, QLabel.BadgeCrimson, QLabel[class="badge-crimson"], QLabel[class~="badge-crimson"] {
    background-color: rgba(244, 63, 94, 0.14);
    color: #F43F5E;
    border: 1px solid #F43F5E;
    border-radius: 4px;
    padding: 3px 8px;
    font-weight: 700;
    font-size: 11px;
}

QLabel.badge-amber, QLabel.BadgeAmber, QLabel[class="badge-amber"], QLabel[class~="badge-amber"] {
    background-color: rgba(245, 158, 11, 0.14);
    color: #F59E0B;
    border: 1px solid #F59E0B;
    border-radius: 4px;
    padding: 3px 8px;
    font-weight: 700;
    font-size: 11px;
}

QLabel.badge-cyan, QLabel.BadgeCyan, QLabel[class="badge-cyan"], QLabel[class~="badge-cyan"] {
    background-color: rgba(6, 182, 212, 0.14);
    color: #38BDF8;
    border: 1px solid #0891B2;
    border-radius: 4px;
    padding: 3px 8px;
    font-weight: 700;
    font-size: 11px;
}
