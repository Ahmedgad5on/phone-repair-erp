{
  "name": "modular-mobile-erp",
  "version": "2.0.0",
  "description": "Modular Mobile ERP & POS (Desktop-First) for Repair Labs, Retail, Spare Parts Wholesale, and Fintech E-Wallets",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "node -e \"const { spawn } = require('child_process'); spawn('npm', ['run', 'dev:server'], { stdio: 'inherit', shell: true }); spawn('npm', ['run', 'dev:client'], { stdio: 'inherit', shell: true });\"",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "build": "npm run build:server && npm run build:client",
    "test": "cd server && npm test",
    "test:client": "cd client && npx vitest run",
    "test:all": "npm run test && npm run test:client",
    "test:coverage": "cd server && npx vitest run --coverage",
    "seed": "cd server && npm run seed",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "cd server && npx tsc --noEmit && cd ../client && npx tsc --noEmit",
    "electron:start": "npx electron electron/main.cjs",
    "electron:build": "npx electron-builder",
    "electron:build:win": "npx electron-builder --win",
    "prepare": "husky"
  },
  "keywords": [
    "erp",
    "pos",
    "mobile-repair",
    "spare-parts",
    "fintech",
    "imei",
    "offline-first"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/notarize": "^3.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "c8": "^12.0.0",
    "depcheck": "^1.4.7",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "madge": "^8.0.0",
    "npkill": "^0.12.2",
    "prettier": "^3.9.6",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.0"
  }
}
